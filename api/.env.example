# Copy to .env.development / .env.production. Values marked SAME AS BACKEND must match ../backend exactly.

PORT=4002
NODE_ENV=development

# Shared PostgreSQL database — SAME AS BACKEND
DATABASE_URL=postgresql://user:password@localhost:5432/newel_planner

# JWT — SAME AS BACKEND (tokens must be valid on both services)
JWT_SECRET=
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRES_IN=7d

# Cookies (the app reads the token from the login response body; cookies are optional)
COOKIE_SAME_SITE=
COOKIE_SECURE=
COOKIE_DOMAIN=

# Comma-separated origins allowed by CORS (only matters for the Expo web build). Empty = allow all.
CORS_ORIGINS=

# Web app URL — used for the "Open" link in activity notification emails
FRONTEND_URL=

# Voice notes are stored in <UPLOAD_DIR>/activity-voice.
# Point this at the backend's uploads folder, or copy backend/uploads/activity-voice here,
# so voice notes recorded before the split keep playing.
UPLOAD_DIR=./uploads

# Email (SMTP, or Microsoft Graph when all four MS_* values are set) — SAME AS BACKEND
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SHARED_MAILBOX=

# S3 file attachments — SAME AS BACKEND bucket
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
