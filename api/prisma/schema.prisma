  APPROVED
  REJECTED
}

model AttendanceRegularization {
  id                   String               @id @default(uuid())
  userId               String
  attendanceId         String?
  date                 DateTime             @db.Timestamptz(3)
  requestedIn          DateTime?            @db.Timestamptz(3)
  requestedInTimeZone  String?
  requestedOut         DateTime?            @db.Timestamptz(3)
  requestedOutTimeZone String?
  reason               RegularizationReason
  remarks              String?
  status               RegularizationStatus @default(PENDING)
  approverId           String?
  approvedAt           DateTime?
  // Approver's note on the decision — distinct from `remarks`, which is the
  // requester's justification. Surfaced in the decision email.
  decisionRemarks      String?
  // Message-ID of the request mail sent to the reporting authority. The decision
  // mail references it so both land in one conversation.
  requestMailMessageId String?
  requestMailSentAt    DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  user                 User                 @relation(fields: [userId], references: [id])
  approver             User?                @relation("RegularizationApprover", fields: [approverId], references: [id])
  attendance           Attendance?          @relation(fields: [attendanceId], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
}

