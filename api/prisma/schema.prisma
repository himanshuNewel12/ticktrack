// ── WORKFLOW ENGINE ───────────────────────────────────────────────────────────

enum WorkflowAction {
  APPROVE
  REJECT
  SEND_BACK
  DELEGATE
  ESCALATE
}

enum WorkflowStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApproverType {
  ROLE
  USER
  REPORTING_AUTHORITY
}

model WorkflowTemplate {
  id        String             @id @default(uuid())
  module    String // LEAVE, TIMESHEET, DEMAND, PROJECT, CR, ALLOCATION_OVERRIDE
  name      String
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  steps     WorkflowStep[]
  instances WorkflowInstance[]
}

model WorkflowStep {
  id                 String           @id @default(uuid())
  templateId         String
  stepOrder          Int
  stepName           String
  approverType       ApproverType     @default(ROLE)
  approverRoleId     String? // if type = ROLE
  approverUserId     String? // if type = USER
  escalateAfterHours Int? // null = no auto-escalation
  allowDelegate      Boolean          @default(true)
  template           WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, stepOrder])
}

model WorkflowInstance {
  id          String              @id @default(uuid())
  templateId  String
  entityType  String // LEAVE, TIMESHEET, DEMAND, PROJECT, CR
  entityId    String
  currentStep Int                 @default(1)
  status      WorkflowStatus      @default(PENDING)
  requesterId String
  remarks     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  template    WorkflowTemplate    @relation(fields: [templateId], references: [id])
  requester   User                @relation("WorkflowRequester", fields: [requesterId], references: [id])
  actions     WorkflowActionLog[]
}

model WorkflowActionLog {
  id          String           @id @default(uuid())
  instanceId  String
  stepOrder   Int
  actorId     String
  action      WorkflowAction
  remarks     String?
  delegatedTo String?
  takenAt     DateTime         @default(now())
  instance    WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  actor       User             @relation("WorkflowActor", fields: [actorId], references: [id])
}

model Freelancer {
  id             String            @id @default(uuid())
  freelancerCode String            @unique
  fullName       String
  email          String            @unique
  mobile         String?
  vendorId       String?
  experience     Int?
  country        String?
  location       String?
  contractStart  DateTime
  contractEnd    DateTime
  rateType       RateType          @default(HOURLY)
  costPerHour    Float
  billingRate    Float
  currencyId     String?
  ndaStatus      NdaStatus         @default(PENDING)
  agreementUrl   String?
  status         FreelancerStatus  @default(ACTIVE)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  vendor         Vendor?           @relation(fields: [vendorId], references: [id])
  currency       Currency?         @relation(fields: [currencyId], references: [id])
  skills         FreelancerSkill[]
  allocations    Allocation[]
  timesheets     Timesheet[]

  @@index([vendorId])
  @@index([status])
}

model FreelancerSkill {
  freelancerId String
  skillId      String
  level        Int        @default(1)
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id])

  @@id([freelancerId, skillId])
}

// -- NOTIFICATIONS -------------------------------------------------------------
enum NotificationType {
  TIMESHEET_REMINDER
  APPROVAL_PENDING
  APPROVED
  REJECTED
  CONTRACT_EXPIRY
  MILESTONE_OVERDUE
  LEAVE_BALANCE_LOW
  BUDGET_EXCEEDED
  ALLOCATION_CONFLICT
  ISSUE_ESCALATED
  TRAINING_COMPLETED
  TRAINING_CERTIFICATE_ISSUED
  PROJECT_DORMANT
  ACTIVITY_ASSIGNED
  ACTIVITY_POSTPONED
  ACTIVITY_COMPLETED
  ACTIVITY_CANCELLED
  ACTIVITY_SERIES_ASSIGNED
  ACTIVITY_SERIES_CANCELLED
  ACTIVITY_REMARK_ADDED
  ACTIVITY_ESCALATED
  TASK_ASSIGNED
  GENERAL
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
