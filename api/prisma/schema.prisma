model NotificationPreference {
  id     String           @id @default(uuid())
  userId String
  type   NotificationType
  inApp  Boolean          @default(true)
  email  Boolean          @default(true)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

// ── DEMAND / INTAKE ──────────────────────────────────────────────────────────

enum DemandStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CONVERTED
}

enum DemandPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model Demand {
  id                 String          @id @default(uuid())
  demandCode         String          @unique
  title              String
  description        String?
  requesterId        String
  departmentId       String?
  estimatedTimeline  DateTime?
  estimatedBudget    Float?
  priority           DemandPriority  @default(MEDIUM)
  attachmentUrl      String?
  status             DemandStatus    @default(DRAFT)
  reviewerRemarks    String?
  convertedProjectId String?         @unique
  workflowInstanceId String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  requester          User            @relation("DemandRequester", fields: [requesterId], references: [id])
  department         Department?     @relation(fields: [departmentId], references: [id])
  convertedProject   Project?        @relation(fields: [convertedProjectId], references: [id])
  comments           DemandComment[]
}

model DemandComment {
  id        String   @id @default(uuid())
  demandId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

// -- CHANGE REQUESTS -----------------------------------------------------------

enum CRType {
  SCOPE
  BUDGET
  TIMELINE
  RESOURCE
  COMBINED
}

enum CRStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  IN_PROGRESS
  CLOSED
  DEFERRED
  ON_HOLD
}

enum CRPhase {
  REQUIREMENT
  DESIGN
  DEVELOPMENT
  TESTING
  UAT
  DEPLOYMENT
}

model ChangeRequest {
  id                 String      @id @default(uuid())
  crCode             String      @unique
  projectId          String
  title              String
  type               CRType
  description        String?
  impactedScope      String? // free text describing scope changes
  budgetDelta        Float? // +ve = increase, -ve = decrease
  timelineDeltaDays  Int? // number of days to extend endDate
  resourceChanges    Json? // [{ action: "ADD"|"REMOVE"|"CHANGE", resourceId, role, percentage }]
  status             CRStatus    @default(DRAFT)
  requesterId        String
  workflowInstanceId String?
  approvedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  project            Project     @relation(fields: [projectId], references: [id])
  requester          User        @relation("CRRequester", fields: [requesterId], references: [id])
  comments           CRComment[]
  tasks              Task[]
}

model CRComment {
  id        String        @id @default(uuid())
  crId      String
  authorId  String
  body      String
  createdAt DateTime      @default(now())
  cr        ChangeRequest @relation(fields: [crId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id])
}

enum DocType {
  BRD
  FRD
  SOW
  CONTRACT
  DESIGN
  TEST_SIGNOFF
  INVOICE
  NDA
  AGREEMENT
  PROPOSAL
  OTHER
}

model Document {
  id           String   @id @default(uuid())
  entityType   String // PROJECT, DEMAND, CR, VENDOR, FREELANCER, CLIENT
  entityId     String
  docType      DocType
  name         String
  originalName String
  fileUrl      String
  mimeType     String
  sizeBytes    Int
  version      Int      @default(1)
  isLatest     Boolean  @default(true)
  description  String?
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@index([entityType, entityId, docType, isLatest])
}

// ── RISK REGISTER ─────────────────────────────────────────────────────────────

enum RiskProbability {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum RiskImpact {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MITIGATING
  MITIGATED
  ACCEPTED
  CLOSED
}

model Risk {
  id          String          @id @default(uuid())
  projectId   String
  title       String
  description String?
  probability RiskProbability
  impact      RiskImpact
  riskScore   Int
  mitigation  String?
  contingency String?
  ownerId     String
  status      RiskStatus      @default(OPEN)
