// ── DEPENDENCY REGISTER ───────────────────────────────────────────────────────

enum DependencyType {
  INTERNAL
  EXTERNAL
}

enum DependencyStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  BLOCKED
}

model Dependency {
  id          String           @id @default(uuid())
  projectId   String
  title       String
  description String?
  type        DependencyType   @default(INTERNAL)
  fromTaskId  String?
  toTaskId    String?
  externalRef String?
  ownerId     String
  status      DependencyStatus @default(OPEN)
  dueDate     DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User             @relation("DependencyOwner", fields: [ownerId], references: [id])
  fromTask    Task?            @relation("DependencyFrom", fields: [fromTaskId], references: [id])
  toTask      Task?            @relation("DependencyTo", fields: [toTaskId], references: [id])

