{
  "expo": {
    "name": "TickTrack",
    "slug": "ticktrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ticktrack.png",
    "scheme": "ticktrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.ticktrack"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ticktrack.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.ticktrack"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/ticktrack.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ticktrack.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "backendUrl": "https://newelplanner-revamp-api-uat.neweltechnologies.in/api/v1",
      "eas": {
        "projectId": "2512b94e-a398-44b6-9c8b-274432555fd7"
      }
    }
  }
}