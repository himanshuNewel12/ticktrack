# For LOCAL dev only (when running local backend on PC port 4001):
# EXPO_PUBLIC_API_URL=http://localhost:4001/api/v1

# prod
EXPO_PUBLIC_API_URL=https://newelplanner-revamp-api-prod.neweltechnologies.in/api/v1