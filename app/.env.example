# Keep React Native standard fetch (prevents HTTP/2 stream reset bug)
EXPO_PUBLIC_USE_RN_FETCH=true

# Target Backend URL:
# -------------------------------------------------------------
# 1) To run against your LOCAL backend (PC port 4001):
#    Keep localhost:4001 (mobile devices will automatically resolve to host IP 10.34.136.52)
EXPO_PUBLIC_API_URL=http://localhost:4001/api/v1

# 2) To run against REMOTE UAT backend:
# EXPO_PUBLIC_API_URL=https://newelplanner-revamp-api-uat.neweltechnologies.in/api/v1
