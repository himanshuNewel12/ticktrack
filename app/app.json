{
  "expo": {
    "name": "TickTrack",
    "slug": "ticktrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/ticktrack.png",
    "scheme": "ticktrack",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.ticktrack"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1B293B"
      },
      "package": "com.neweltechnologies.ticktrack"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#00000000",
      "translucent": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/ticktrack.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash_transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0F1D"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow TickTrack to use the microphone to record voice notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "backendUrl": "https://ticktrack-api.neweltechnologies.com/api/v1"
    }
  }
}
